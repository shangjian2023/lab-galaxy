# Copy the values you need into the ignored root .env.local.
# Never prefix secrets with NEXT_PUBLIC_ and never commit real credentials.

# Primary extraction / RAG generation provider (OpenAI-compatible).
LLM_BASE_URL=https://api.mazhuoran.cloud/v1
LLM_MODEL=qwen3.7-plus
LLM_API_KEY=
LLM_CONTEXT_TOKENS=32768
LLM_REQUEST_TIMEOUT_SECONDS=180

# SiliconFlow embedding provider (OpenAI-compatible).
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_INPUT_TOKENS=8192

# Optional legacy SiliconFlow chat model retained as a configurable fallback.
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_LLM_MODEL=Qwen/Qwen3.6-27B
SILICONFLOW_API_KEY=

# RAG defaults; data and index must be rebuilt when model/dimension changes.
RAG_TOP_K=8
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=80
